# /etc/default/srtla-control — settings for srtla-control.service
# Put it behind a TLS reverse proxy (wss:// / https://) in production.

SRTLA_CONTROL_ARGS=--host 127.0.0.1 --port 8090

# Shared token devices use (SRTLA_REMOTE_TOKEN on the device). For per-device
# tokens add: --devices /etc/srtla-control/devices.json  ({"cam1": "token", ...})
SRTLA_DEVICE_TOKEN=change-me

# Browser login (HTTP Basic)
SRTLA_UI_USER=admin
SRTLA_UI_PASSWORD=change-me
