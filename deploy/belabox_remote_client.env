# /etc/default/srtla-relay — settings for srtla-relay.service

# Device type: relay | encoder | combined
BELABOX_ROLE=relay

# Extra command-line arguments (web UI / API bind address, reload mode, ...)
SRTLA_ARGS=--host 0.0.0.0 --port 8085

# Control server (optional). The token authenticates this device
# (its uuid is auto-assigned and stored in the config file).
#SRTLA_REMOTE_URL=wss://control.example.com/device
#SRTLA_REMOTE_TOKEN=change-me

# Binaries and pipelines (encoder / combined)
#SRTLA_SEND_BIN=/usr/bin/srtla_send
#ENCODER_BIN=/usr/bin/belacoder
#BELACODER_PIPELINES=/usr/share/belacoder/pipelines
